#!/bin/sh

# 应用配置
APP_NAME=${jarPath}fa-admin.jar
JAVA_BIN=${javaPath}
SPRING_PROFILE=${jarEnv}

# 授权中心部署时通过环境变量传入私钥文件路径；客户端部署时保持为空
LICENSE_CENTER_PRIVATE_KEY_FILE="${LICENSE_CENTER_PRIVATE_KEY_FILE:-}"

APP_DIR=$(dirname "${APP_NAME}")
PID_FILE="${APP_DIR}/fa-admin.pid"
LOG_FILE="${APP_DIR}/fa-admin.log"

usage() {
  echo "Usage: sh $(basename "$0") [start|stop|restart|status]"
  exit 1
}

# 仅识别由本脚本写入且命令行包含目标 JAR 的进程，避免误杀其他 Java 进程
is_exist() {
  pid=""
  if [ -r "${PID_FILE}" ]; then
    pid=$(cat "${PID_FILE}")
    case "${pid}" in
      ''|*[!0-9]*)
        pid=""
        ;;
      *)
        if kill -0 "${pid}" 2>/dev/null \
          && ps -p "${pid}" -o args= 2>/dev/null | grep -F -- "${APP_NAME}" >/dev/null 2>&1; then
          return 0
        fi
        pid=""
        ;;
    esac
  fi
  return 1
}

start() {
  if is_exist; then
    echo "${APP_NAME} is already running. pid=${pid}"
    return 0
  fi

  if [ ! -f "${APP_NAME}" ]; then
    echo "${APP_NAME} does not exist"
    return 1
  fi

  if ! mkdir -p "${APP_DIR}"; then
    echo "Cannot create application directory: ${APP_DIR}"
    return 1
  fi

  nohup env \
    LICENSE_CENTER_PRIVATE_KEY_FILE="${LICENSE_CENTER_PRIVATE_KEY_FILE}" \
    "${JAVA_BIN}" -jar "${APP_NAME}" \
    --spring.profiles.active="${SPRING_PROFILE}" \
    >> "${LOG_FILE}" 2>&1 &

  pid=$!
  echo "${pid}" > "${PID_FILE}"
  sleep 1
  if kill -0 "${pid}" 2>/dev/null; then
    echo "${APP_NAME} started. pid=${pid}"
    return 0
  fi

  rm -f "${PID_FILE}"
  echo "${APP_NAME} failed to start. Check ${LOG_FILE}"
  return 1
}

stop() {
  if ! is_exist; then
    rm -f "${PID_FILE}"
    echo "${APP_NAME} is not running"
    return 0
  fi

  if ! kill "${pid}" 2>/dev/null; then
    echo "Failed to stop ${APP_NAME}. pid=${pid}"
    return 1
  fi

  wait_seconds=0
  while kill -0 "${pid}" 2>/dev/null && [ "${wait_seconds}" -lt 30 ]; do
    sleep 1
    wait_seconds=$((wait_seconds + 1))
  done

  if kill -0 "${pid}" 2>/dev/null; then
    echo "${APP_NAME} did not stop gracefully; sending SIGKILL"
    kill -9 "${pid}" 2>/dev/null
  fi

  rm -f "${PID_FILE}"
  echo "${APP_NAME} stopped"
}

status() {
  if is_exist; then
    echo "${APP_NAME} is running. pid=${pid}"
  else
    echo "${APP_NAME} is NOT running."
  fi
}

restart() {
  stop || return 1
  start
}

case "${1:-}" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  status)
    status
    ;;
  restart)
    restart
    ;;
  *)
    usage
    ;;
esac
